rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == "superadmin59@gmail.com";
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userDoc().data.role == "admin";
    }

    function isUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userDoc().data.role == "user";
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function isGroupAdmin(groupId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/groups/$(groupId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.adminIds;
    }

    match /users/{userId} {

      allow create: if
        isSuperAdmin()
        ||
        (
          isAdmin()
          && request.resource.data.role == "user"
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.adminIds
        )
        ||
        isOwner(userId);

      allow read: if
        isSuperAdmin()
        ||
        isOwner(userId)
        ||
        (
          isAdmin()
          && request.auth.uid in resource.data.adminIds
        );

      allow update: if
        isSuperAdmin()
        ||
        isOwner(userId)
        ||
        (
          isAdmin()
          && request.auth.uid in resource.data.adminIds
        );

      allow delete: if
        isSuperAdmin()
        ||
        (
          isAdmin()
          && request.auth.uid in resource.data.adminIds
        );
    }

    match /groups/{groupId} {

      allow read: if
        isSuperAdmin()
        ||
        isGroupAdmin(groupId);

      allow create: if
        isSuperAdmin()
        ||
        (
          isAdmin()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.adminIds
        );

      allow update: if
        isSuperAdmin()
        ||
        isGroupAdmin(groupId);

      allow delete: if
        isSuperAdmin()
        ||
        isGroupAdmin(groupId);
    }

    match /groupMembers/{memberId} {

      allow read: if
        isSuperAdmin()
        ||
        isAdmin();

      allow create, update, delete: if
        isSuperAdmin()
        ||
        isAdmin();
    }

    match /tasks/{taskId} {

      allow read: if
        isSuperAdmin()
        ||
        (
          signedIn()
          &&
          (
            request.auth.uid in resource.data.visibleToAdminIds
            ||
            resource.data.assignedTo == request.auth.uid
          )
        );

      allow create: if
        isSuperAdmin()
        ||
        (
          isAdmin()
          &&
          request.auth.uid in request.resource.data.visibleToAdminIds
          &&
          request.resource.data.assignedBy == request.auth.uid
        );

      allow update: if
        isSuperAdmin()
        ||
        (
          signedIn()
          &&
          (
            request.auth.uid in resource.data.visibleToAdminIds
            ||
            resource.data.assignedTo == request.auth.uid
          )
        );

      allow delete: if
        isSuperAdmin()
        ||
        (
          isAdmin()
          &&
          request.auth.uid in resource.data.visibleToAdminIds
        );
    }
  }
}
